{
  "name": "ORCA Agentic Dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "ORCA Voice Room",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "bash -lc 'nohup uvicorn app.main:app --host 0.0.0.0 --port 8000 >/tmp/orca-uvicorn.log 2>&1 &'"
}
